// The type check, with no emit: the sources are the plain .js that ships, each typed by its JSDoc,
// so the tag's tree installs with no build. The tests and scripts are checked beside them.
// Adapted from spike-html-apps-foundation (9c15b8d): tsconfig.json, checking JavaScript on node.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2025"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": false
  },
  "include": ["src", "test", "scripts", "eslint.config.js"]
}
