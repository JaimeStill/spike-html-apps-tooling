// The build, src/ into dist/: tsc emits each module's .js and .d.ts, rewriting the sources' .ts
// specifiers to .js. mise run types checks the same sources with --noEmit.
// Adapted from spike-html-apps-foundation (9c15b8d): tsconfig.json, on node.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2025"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": ["src"]
}
